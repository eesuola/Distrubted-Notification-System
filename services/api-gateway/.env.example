# Service Configuration
SERVICE_NAME=api-gateway
HOST=0.0.0.0
PORT=3000
SERVICE_VERSION=1.0.0
NODE_ENV=development

# Service Names
API_GATEWAY_SERVICE_NAME=api-gateway
USER_SERVICE_NAME=user-service
EMAIL_SERVICE_NAME=email-service
PUSH_SERVICE_NAME=push-service
TEMPLATE_SERVICE_NAME=template-service

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=notifications.direct
RABBITMQ_EXCHANGE_TYPE=direct
RABBITMQ_EMAIL_QUEUE=email.queue
RABBITMQ_PUSH_QUEUE=push.queue
RABBITMQ_FAILED_QUEUE=failed.queue
RABBITMQ_RECONNECT_DELAY=5000
RABBITMQ_MAX_RECONNECT_ATTEMPTS=10
RABBITMQ_CONNECTION_TIMEOUT=30000
RABBITMQ_HEARTBEAT=60

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RETRY_DELAY_ON_FAILOVER=100
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_LAZY_CONNECT=true
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000
REDIS_DEFAULT_TTL=86400
REDIS_NOTIFICATION_STATUS_TTL=604800

# Consul Configuration
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_HEALTH_CHECK_INTERVAL=10s
CONSUL_HEALTH_CHECK_TIMEOUT=5s
CONSUL_DEREGISTER_CRITICAL_SERVICE_AFTER=30s
CONSUL_SERVICE_QUERY_TIMEOUT=5000
CONSUL_MAX_SERVICE_QUERY_RETRIES=3

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIME_WINDOW=60
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true
RATE_LIMIT_SKIP_FAILED_REQUESTS=true

# Circuit Breaker Configuration
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50.0
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_MONITORING_PERIOD=10000
CIRCUIT_BREAKER_MINIMUM_REQUESTS=10

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY_PRINT=false
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_HOSTNAME=true
LOG_INCLUDE_PID=true

# API Configuration
API_PREFIX=/api/v1
API_DOCUMENTATION_ENABLED=true
API_DOCUMENTATION_PATH=/documentation
CORS_ENABLED=true
CORS_ORIGIN=*

# Notification Configuration
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=5000
NOTIFICATION_MAX_BATCH_SIZE=100
NOTIFICATION_DEFAULT_PRIORITY=5
NOTIFICATION_IDEMPOTENCY_TTL=86400